# CPack staging hook generated by CaePackage.cmake.

set(_runtime_files "@CAE_PACKAGE_BUNDLE_RUNTIME_FILES@")
set(_dependency_roots "@CAE_PACKAGE_BUNDLE_DEPENDENCY_ROOTS@")
set(_runtime_name_regexes [==[@CAE_PACKAGE_BUNDLE_RUNTIME_NAME_REGEXES@]==])
set(_runtime_dest "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CAE_PACKAGE_BUNDLED_DEPENDENCY_DESTINATION@")
set(_license_dest "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CAE_PACKAGE_BUNDLED_LICENSE_DESTINATION@")

file(MAKE_DIRECTORY "${_runtime_dest}")
file(MAKE_DIRECTORY "${_license_dest}")

function(_cae_bundle_runtime_name_allowed OUT_VAR FILE_PATH)
    if(NOT _runtime_name_regexes)
        set("${OUT_VAR}" TRUE PARENT_SCOPE)
        return()
    endif()

    get_filename_component(_file_name "${FILE_PATH}" NAME)
    foreach(_runtime_name_regex IN LISTS _runtime_name_regexes)
        if(_file_name MATCHES "${_runtime_name_regex}")
            set("${OUT_VAR}" TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()

    set("${OUT_VAR}" FALSE PARENT_SCOPE)
endfunction()

function(_cae_bundle_copy_runtime_file FILE_PATH)
    if(NOT FILE_PATH OR NOT EXISTS "${FILE_PATH}")
        return()
    endif()
    _cae_bundle_runtime_name_allowed(_runtime_name_allowed "${FILE_PATH}")
    if(NOT _runtime_name_allowed)
        return()
    endif()

    file(INSTALL FILES "${FILE_PATH}"
        DESTINATION "${_runtime_dest}"
        FOLLOW_SYMLINK_CHAIN
    )
endfunction()

function(_cae_bundle_copy_runtime_dir DIR_PATH)
    if(NOT IS_DIRECTORY "${DIR_PATH}")
        return()
    endif()

    file(GLOB _runtime_files_in_dir
        FOLLOW_SYMLINKS
        "${DIR_PATH}/*.dll"
        "${DIR_PATH}/*.so"
        "${DIR_PATH}/*.so.*"
        "${DIR_PATH}/*.dylib"
        "${DIR_PATH}/*.dylib.*"
    )
    foreach(_runtime_file IN LISTS _runtime_files_in_dir)
        _cae_bundle_copy_runtime_file("${_runtime_file}")
    endforeach()
endfunction()

foreach(_runtime_file IN LISTS _runtime_files)
    _cae_bundle_copy_runtime_file("${_runtime_file}")
endforeach()

foreach(_dependency_root IN LISTS _dependency_roots)
    if(NOT IS_DIRECTORY "${_dependency_root}")
        message(WARNING
            "CAE package dependency root does not exist and will be skipped: "
            "${_dependency_root}")
        continue()
    endif()

    if(WIN32)
        set(_runtime_dirs
            "${_dependency_root}/bin"
            "${_dependency_root}/bin/release"
            "${_dependency_root}/lib"
            "${_dependency_root}/lib/release"
            "${_dependency_root}/lib/rt_dynamic/release"
        )
        if(CMAKE_INSTALL_CONFIG_NAME MATCHES "^[Dd]ebug$")
            list(APPEND _runtime_dirs
                "${_dependency_root}/bin/debug"
                "${_dependency_root}/lib/debug"
                "${_dependency_root}/lib/rt_dynamic/debug"
            )
        endif()
    else()
        set(_runtime_dirs
            "${_dependency_root}/lib"
            "${_dependency_root}/lib/release"
            "${_dependency_root}/lib/rt_dynamic/release"
            "${_dependency_root}/lib64"
            "${_dependency_root}/bin"
        )
        if(CMAKE_INSTALL_CONFIG_NAME MATCHES "^[Dd]ebug$")
            list(APPEND _runtime_dirs
                "${_dependency_root}/lib/debug"
                "${_dependency_root}/lib/rt_dynamic/debug"
                "${_dependency_root}/bin/debug"
            )
        endif()
    endif()

    foreach(_runtime_dir IN LISTS _runtime_dirs)
        _cae_bundle_copy_runtime_dir("${_runtime_dir}")
    endforeach()

    foreach(_license_dir_name IN ITEMS PACKAGE-LICENSES licenses Licenses)
        set(_license_dir "${_dependency_root}/${_license_dir_name}")
        if(IS_DIRECTORY "${_license_dir}")
            file(INSTALL "${_license_dir}/"
                DESTINATION "${_license_dest}"
            )
        endif()
    endforeach()
endforeach()

if(UNIX AND NOT APPLE)
    find_program(_patchelf_EXECUTABLE patchelf)
    if(NOT _patchelf_EXECUTABLE)
        message(FATAL_ERROR
            "CAE_PACKAGE_BUNDLE_DIRECT_DEPS requires patchelf on Linux so "
            "bundled dependency libraries can be made relocatable")
    endif()

    file(GLOB _installed_runtime_files
        "${_runtime_dest}/*.so"
        "${_runtime_dest}/*.so.*"
    )
    foreach(_installed_runtime_file IN LISTS _installed_runtime_files)
        if(IS_SYMLINK "${_installed_runtime_file}")
            continue()
        endif()

        file(READ "${_installed_runtime_file}" _elf_magic LIMIT 4 HEX)
        if(NOT _elf_magic STREQUAL "7f454c46")
            continue()
        endif()

        execute_process(
            COMMAND "${_patchelf_EXECUTABLE}" --set-rpath "$ORIGIN" "${_installed_runtime_file}"
            RESULT_VARIABLE _patchelf_result
        )
        if(NOT _patchelf_result EQUAL 0)
            message(FATAL_ERROR
                "Failed to set bundled dependency RPATH on "
                "${_installed_runtime_file}")
        endif()
    endforeach()
endif()
