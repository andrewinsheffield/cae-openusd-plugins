get_filename_component(_CAE_SDK_CACHE_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)

set(CAE_FORMAT_DEPS_LINKAGE "@CAE_SB_FORMAT_DEPS_LINKAGE@" CACHE STRING
    "Library linkage provided by the generated file-format dependency SDK" FORCE)
set_property(CACHE CAE_FORMAT_DEPS_LINKAGE PROPERTY STRINGS shared static)

set(CAE_ENABLE_VTK @CAE_SB_FORMAT_ENABLE_VTK@ CACHE BOOL
    "Enable VTK support when consuming the generated dependency SDK")
set(CAE_ENABLE_CGNS @CAE_SB_FORMAT_ENABLE_CGNS@ CACHE BOOL
    "Enable CGNS when consuming the generated dependency SDK")
set(CAE_ENABLE_EDEM @CAE_SB_FORMAT_ENABLE_EDEM@ CACHE BOOL
    "Enable EDEM/HDF5 when consuming the generated dependency SDK")
set(CAE_ENABLE_VTKHDF @CAE_SB_FORMAT_ENABLE_VTKHDF@ CACHE BOOL
    "Enable VTKHDF/HDF5 (DEM particle sim) when consuming the generated dependency SDK")
set(CAE_ENABLE_FLASH @CAE_SB_FORMAT_ENABLE_FLASH@ CACHE BOOL
    "Enable FLASH/HDF5 when consuming the generated dependency SDK")
set(CAE_PACKAGE_BUNDLE_DIRECT_DEPS @CAE_SB_FORMAT_PACKAGE_BUNDLE_DIRECT_DEPS@ CACHE BOOL
    "Bundle generated direct dependency runtimes into CPack/wheel payloads" FORCE)

if("@CAE_SB_FORMAT_ENABLE_FORMAT_DEPS@" STREQUAL "ON")
    set(CAE_SDK_ROOT "${_CAE_SDK_CACHE_DIR}" CACHE PATH
        "Root of the generated file-format dependency SDK")
    set(CAE_PACKAGE_DEPENDENCY_ROOTS "${_CAE_SDK_CACHE_DIR}" CACHE STRING
        "Dependency runtime roots eligible for CPack/wheel bundling")
    foreach(_CAE_SDK_CACHE_ROOT_VAR IN ITEMS
            pugixml_ROOT
            PUGIXML_ROOT
            LZ4_ROOT
            ZLIB_ROOT
            LibLZMA_ROOT
            LIBLZMA_ROOT
            HDF5_ROOT
            CGNS_ROOT)
        set("${_CAE_SDK_CACHE_ROOT_VAR}" "${_CAE_SDK_CACHE_DIR}" CACHE PATH
            "Root of the generated file-format dependency SDK" FORCE)
    endforeach()
    unset(_CAE_SDK_CACHE_ROOT_VAR)

    function(_cae_sdk_cache_set_first_existing_file VAR DOC)
        foreach(_candidate IN LISTS ARGN)
            if(EXISTS "${_candidate}")
                set("${VAR}" "${_candidate}" CACHE FILEPATH "${DOC}" FORCE)
                return()
            endif()
        endforeach()
    endfunction()

    set(ZLIB_INCLUDE_DIR "${_CAE_SDK_CACHE_DIR}/include" CACHE PATH
        "zlib include directory from the generated file-format dependency SDK" FORCE)
    set(LIBLZMA_INCLUDE_DIR "${_CAE_SDK_CACHE_DIR}/include" CACHE PATH
        "liblzma include directory from the generated file-format dependency SDK" FORCE)
    if("@CAE_SB_FORMAT_DEPS_LINKAGE@" STREQUAL "static")
        set(ZLIB_USE_STATIC_LIBS ON CACHE BOOL
            "Prefer static zlib from the generated file-format dependency SDK" FORCE)
        set(HDF5_USE_STATIC_LIBRARIES ON CACHE BOOL
            "Prefer static HDF5 from the generated file-format dependency SDK" FORCE)
        _cae_sdk_cache_set_first_existing_file(ZLIB_LIBRARY
            "Static zlib library from the generated file-format dependency SDK"
            "${_CAE_SDK_CACHE_DIR}/lib/libz.a"
            "${_CAE_SDK_CACHE_DIR}/lib64/libz.a"
            "${_CAE_SDK_CACHE_DIR}/lib/zlibstatic.lib"
            "${_CAE_SDK_CACHE_DIR}/lib64/zlibstatic.lib"
            "${_CAE_SDK_CACHE_DIR}/lib/zlib.lib"
            "${_CAE_SDK_CACHE_DIR}/lib64/zlib.lib")
        _cae_sdk_cache_set_first_existing_file(LIBLZMA_LIBRARY
            "Static liblzma library from the generated file-format dependency SDK"
            "${_CAE_SDK_CACHE_DIR}/lib/liblzma.a"
            "${_CAE_SDK_CACHE_DIR}/lib64/liblzma.a"
            "${_CAE_SDK_CACHE_DIR}/lib/lzma.lib"
            "${_CAE_SDK_CACHE_DIR}/lib64/lzma.lib"
            "${_CAE_SDK_CACHE_DIR}/lib/liblzma.lib"
            "${_CAE_SDK_CACHE_DIR}/lib64/liblzma.lib")
    else()
        set(ZLIB_USE_STATIC_LIBS OFF CACHE BOOL
            "Prefer shared zlib from the generated file-format dependency SDK" FORCE)
        set(HDF5_USE_STATIC_LIBRARIES OFF CACHE BOOL
            "Prefer shared HDF5 from the generated file-format dependency SDK" FORCE)
        unset(ZLIB_LIBRARY CACHE)
        unset(ZLIB_LIBRARY_RELEASE CACHE)
        unset(ZLIB_LIBRARY_DEBUG CACHE)
        unset(LIBLZMA_LIBRARY CACHE)
        unset(LIBLZMA_LIBRARY_RELEASE CACHE)
        unset(LIBLZMA_LIBRARY_DEBUG CACHE)
    endif()
    unset(_cae_sdk_cache_set_first_existing_file)

    # CMAKE_PREFIX_PATH is not a CMake cache entry here. CMake documents the
    # environment variable as an additional find_package() search source, so
    # append to the process environment before the project configure runs.
    if(WIN32)
        set(_CAE_SDK_CACHE_PATH_SEPARATOR "\;")
    else()
        set(_CAE_SDK_CACHE_PATH_SEPARATOR ":")
    endif()
    if(DEFINED ENV{CMAKE_PREFIX_PATH} AND NOT "$ENV{CMAKE_PREFIX_PATH}" STREQUAL "")
        set(ENV{CMAKE_PREFIX_PATH} "$ENV{CMAKE_PREFIX_PATH}${_CAE_SDK_CACHE_PATH_SEPARATOR}${_CAE_SDK_CACHE_DIR}")
    else()
        set(ENV{CMAKE_PREFIX_PATH} "${_CAE_SDK_CACHE_DIR}")
    endif()
    unset(_CAE_SDK_CACHE_PATH_SEPARATOR)

    if(WIN32)
        set(_CAE_SDK_CACHE_RUNTIME_LIBRARY_DIRS
            "${_CAE_SDK_CACHE_DIR}/bin"
            "${_CAE_SDK_CACHE_DIR}/lib")
    else()
        set(_CAE_SDK_CACHE_RUNTIME_LIBRARY_DIRS
            "${_CAE_SDK_CACHE_DIR}/lib"
            "${_CAE_SDK_CACHE_DIR}/lib64")
    endif()
    if(DEFINED CAE_TEST_RUNTIME_LIBRARY_DIRS
            AND NOT "${CAE_TEST_RUNTIME_LIBRARY_DIRS}" STREQUAL "")
        list(APPEND CAE_TEST_RUNTIME_LIBRARY_DIRS
            ${_CAE_SDK_CACHE_RUNTIME_LIBRARY_DIRS})
    else()
        set(CAE_TEST_RUNTIME_LIBRARY_DIRS
            ${_CAE_SDK_CACHE_RUNTIME_LIBRARY_DIRS})
    endif()
    if(NOT "${CAE_TEST_RUNTIME_LIBRARY_DIRS}" STREQUAL "")
        list(REMOVE_DUPLICATES CAE_TEST_RUNTIME_LIBRARY_DIRS)
    endif()
    set(CAE_TEST_RUNTIME_LIBRARY_DIRS
        "${CAE_TEST_RUNTIME_LIBRARY_DIRS}" CACHE STRING
        "Native runtime library directories used by CTest tests" FORCE)
    unset(_CAE_SDK_CACHE_RUNTIME_LIBRARY_DIRS)
endif()

if("@CAE_SB_FORMAT_ENABLE_USDCORE_TEST_RUNTIME@" STREQUAL "ON")
    # PyPI usd-core keeps its Windows runtime DLLs beside the `pxr` package
    # installed under this SDK's Python target directory. The CTest helper maps
    # this entry to PXR_USD_WINDOWS_DLL_PATH so `pxr.Tf` imports `_tf.pyd`
    # without searching unrelated plugin/dependency directories.
    if(WIN32)
        set(_CAE_SDK_CACHE_USDCORE_RUNTIME_DIRS
            "${_CAE_SDK_CACHE_DIR}/python/pxr")
    else()
        set(_CAE_SDK_CACHE_USDCORE_RUNTIME_DIRS
            "${_CAE_SDK_CACHE_DIR}/python/usd_core.libs")
    endif()
    if(DEFINED CAE_TEST_RUNTIME_LIBRARY_DIRS
            AND NOT "${CAE_TEST_RUNTIME_LIBRARY_DIRS}" STREQUAL "")
        list(APPEND CAE_TEST_RUNTIME_LIBRARY_DIRS
            ${_CAE_SDK_CACHE_USDCORE_RUNTIME_DIRS})
    else()
        set(CAE_TEST_RUNTIME_LIBRARY_DIRS
            ${_CAE_SDK_CACHE_USDCORE_RUNTIME_DIRS})
    endif()
    if(NOT "${CAE_TEST_RUNTIME_LIBRARY_DIRS}" STREQUAL "")
        list(REMOVE_DUPLICATES CAE_TEST_RUNTIME_LIBRARY_DIRS)
    endif()
    set(CAE_TEST_RUNTIME_LIBRARY_DIRS
        "${CAE_TEST_RUNTIME_LIBRARY_DIRS}" CACHE STRING
        "Native runtime library directories used by CTest tests" FORCE)
    unset(_CAE_SDK_CACHE_USDCORE_RUNTIME_DIRS)
endif()

# The superbuild installs the test-only Python packages into the format SDK
# root even when file-format native dependencies are disabled.
set(_CAE_SDK_CACHE_RUNTIME_PYTHONPATH "${_CAE_SDK_CACHE_DIR}/python")
if(DEFINED CAE_TEST_RUNTIME_PYTHONPATH
        AND NOT "${CAE_TEST_RUNTIME_PYTHONPATH}" STREQUAL "")
    list(APPEND CAE_TEST_RUNTIME_PYTHONPATH
        ${_CAE_SDK_CACHE_RUNTIME_PYTHONPATH})
else()
    set(CAE_TEST_RUNTIME_PYTHONPATH
        ${_CAE_SDK_CACHE_RUNTIME_PYTHONPATH})
endif()
if(NOT "${CAE_TEST_RUNTIME_PYTHONPATH}" STREQUAL "")
    list(REMOVE_DUPLICATES CAE_TEST_RUNTIME_PYTHONPATH)
endif()
set(CAE_TEST_RUNTIME_PYTHONPATH
    "${CAE_TEST_RUNTIME_PYTHONPATH}" CACHE STRING
    "Python package directories used by CTest tests" FORCE)
unset(_CAE_SDK_CACHE_RUNTIME_PYTHONPATH)

unset(_CAE_SDK_CACHE_DIR)
