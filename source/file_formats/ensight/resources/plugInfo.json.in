{
    "Plugins": [
        {
            "Name": "omniSciEnSightFileFormat",
            "Type": "library",
            "LibraryPath": "@PLUG_INFO_LIBRARY_PATH@",
            "Root": "@PLUG_INFO_ROOT@",
            "ResourcePath": "@PLUG_INFO_RESOURCE_PATH@",
            "Info": {
                "Types": {
                    "OmniSciEnSightFileFormat": {
                        "bases": ["SdfFileFormat"],
                        "displayName": "CAE EnSight Gold File Format",
                        "extensions": ["case", "encas"],
                        "formatId": "OmniSciEnSightFileFormat",
                        "target": "usd",
                        "primary": false,
                        "FileFormatArguments": {
                            "mountPath": {"doc": "Optional absolute SdfPath where the dataset root should be authored for sublayer composition. Default: derived from the filename stem."},
                            "timeScale": {"doc": "Scale factor applied to the selected EnSight time source. Default: 1.0."},
                            "timeOffset": {"doc": "Offset added after timeScale. Default: 0.0."},
                            "timeSource": {"doc": "Controls the USD time ordinate source. Default: step indices ('TimeStep'). Use 'TimeValue' to sample by the EnSight 'time values:' block when present."},
                            "cacheMode": {"doc": "Lazy-array cache policy: 'all' caches loaded values and 'static' or 'none' do not retain time-sampled values. Default: 'all'."},
                            "ioThreads": {"doc": "Hint controlling the number of internal chunk-read work items for lazy array loading."}
                        }
                    }
                }
            }
        }
    ]
}
