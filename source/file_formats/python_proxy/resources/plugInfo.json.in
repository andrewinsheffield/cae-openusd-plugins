{
    "Plugins": [
        {
            "Name": "omniSciPythonProxyFileFormat",
            "Type": "library",
            "LibraryPath": "@PLUG_INFO_LIBRARY_PATH@",
            "Root": "@PLUG_INFO_ROOT@",
            "ResourcePath": "@PLUG_INFO_RESOURCE_PATH@",
            "Info": {
                "Types": {
                    "OmniSciPythonProxyFileFormat": {
                        "bases": ["SdfFileFormat"],
                        "displayName": "CAE Python Proxy File Format",
                        "extensions": ["pydf"],
                        "formatId": "OmniSciPythonProxyFileFormat",
                        "target": "usd",
                        "primary": false,
                        "FileFormatArguments": {
                            "mountPath": {"doc": "Optional absolute SdfPath where the adapter's root should be authored for sublayer composition. Default: derived from the filename stem."},
                            "cacheMode": {"doc": "Lazy-array cache policy: 'all' caches loaded values and 'static' or 'none' do not retain time-sampled values. Default: 'all'."},
                            "pythonModule": {"doc": "Required unless the plugin hardcodes a module. Python module that implements read(layer, path, metadata_only, args), optional can_read(path), and optional load_array(path, token, time, args). The read callback should author directly into the provided layer and return an optional lazy-field manifest."},
                            "pythonPath": {"doc": "Optional path prepended to sys.path before importing pythonModule."},
                            "pythonReadFunction": {"doc": "Optional override for the structure reader function name. Default: read."},
                            "pythonCanReadFunction": {"doc": "Optional override for the probe function name. Default: can_read."},
                            "pythonLoadArrayFunction": {"doc": "Optional override for the lazy-array loader function name. Default: load_array."}
                        }
                    }
                }
            }
        }
    ]
}
