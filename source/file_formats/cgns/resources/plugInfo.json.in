{
    "Plugins": [
        {
            "Name": "omniSciCgnsFileFormat",
            "Type": "library",
            "LibraryPath": "@PLUG_INFO_LIBRARY_PATH@",
            "Root": "@PLUG_INFO_ROOT@",
            "ResourcePath": "@PLUG_INFO_RESOURCE_PATH@",
            "Info": {
                "Types": {
                    "OmniSciCgnsFileFormat": {
                        "bases": ["SdfFileFormat"],
                        "displayName": "CGNS File Format",
                        "extensions": ["cgns"],
                        "formatId": "OmniSciCgnsFileFormat",
                        "target": "usd",
                        "primary": false,
                        "FileFormatArguments": {
                            "mountPath":   {"doc": "Optional absolute SdfPath where the dataset root should be authored for sublayer composition. Default: derived from the filename stem."},
                            "cacheMode":  {"doc": "Lazy-array cache policy: 'all' caches loaded values and 'static' or 'none' do not retain time-sampled values. Default: 'all'."},
                            "intSize":     {"doc": "Integer precision override: 32 or 64 bits. Default: use type from file."},
                            "floatSize":   {"doc": "Float precision override: 32 or 64 bits. Default: use type from file."},
                            "timeScale":   {"doc": "Scale factor applied to CGNS time values (default: 1.0)."},
                            "timeOffset":  {"doc": "Offset added to CGNS time values after scaling (default: 0.0)."},
                            "timeSource":  {"doc": "Source used as USD time samples: 'TimeStep' (default, zero-based index), 'TimeValue' (BaseIterativeData_t TimeValues array), or 'IterationValue' (BaseIterativeData_t IterationValues array)."},
                            "baseName":    {"doc": "Read only the CGNS base with this name (default: all bases)."},
                            "zoneName":    {"doc": "Read only zones with this name (default: all zones)."}
                        }
                    }
                }
            }
        }
    ]
}
