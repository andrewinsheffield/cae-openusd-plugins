    doc = "Eclipse INIT static-result file-format payload arguments."
)
{
}

class "OmniSciFileFormatArgsUnrstAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "UnrstAPI"
        token apiSchemaType = "singleApply"
    }
    prepend apiSchemas = [
        "OmniSciFileFormatArgsReservoirResultsAPI",
        "OmniSciFileFormatArgsTimeAPI"
    ]
    doc = """Eclipse UNRST restart-result file-format payload arguments.

    UNRST conforms to the generic \\c OmniSciFileFormatArgsTimeAPI surface
    for time-axis selection. The plugin's default
    \\c (source, scale) pair maps \\c DOUBHEAD[0] (simulation days) to
    simulation seconds via \\c (TimeValue, 86400.0). Authoring
    \\c source = TimeStep selects zero-based sample index; authoring
    \\c source = IterationValue interprets the \\c SEQNUM report-step
    counter as the iteration ordinate.
    """
)
{
}

