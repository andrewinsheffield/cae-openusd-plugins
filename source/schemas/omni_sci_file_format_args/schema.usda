class "OmniSciFileFormatArgsReservoirResultsAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "ReservoirResultsAPI"
        token apiSchemaType = "singleApply"
    }
    prepend apiSchemas = [
        "OmniSciFileFormatArgsAPI"
    ]
    doc = "Common Eclipse reservoir result-file payload arguments."
)
{
    uniform token omni:cae:format:reservoir:keywordMode = "whitelist" (
        allowedTokens = [
            "whitelist",
            "allCellSized"
        ]
        doc = """Selects which Eclipse cell-property keywords are exposed as
        \\c OmniSciFieldAPI and \\c OmniSciArrayAPI instances on cell-property
        prims.

        \\li \\em "whitelist"    -- expose only the curated set of standard
            stored keywords supported by the reader.
        \\li \\em "allCellSized" -- expose any numeric record whose stored
            item count matches the logical or active cell count.
        """
        displayName = "Keyword Mode"
        displayGroup = "Reservoir Result File Format"
        customData = {
            string apiName = "reservoirKeywordMode"
        }
    )
}

