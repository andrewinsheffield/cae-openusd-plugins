class "OmniSciFileFormatArgsNpzAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "NpzAPI"
        token apiSchemaType = "singleApply"
    }
    prepend apiSchemas = ["OmniSciFileFormatArgsAPI"]
    doc = "NPZ-specific file-format payload arguments."
)
{
    uniform token omni:cae:format:npz:schema = "Point Cloud" (
        allowedTokens = [
            "Point Cloud",
            "CGNS",
            "None"
        ]
        doc = """Selects the interpretation applied to the arrays inside an
        NPZ archive when authoring USD prims.

        \\li \\em "Point Cloud" -- arrays describe one or more point clouds.
            The \\c coordsArray attribute (or the trio \\c coordsArrayX /
            \\c coordsArrayY / \\c coordsArrayZ) names the position array(s);
            remaining numeric arrays become per-point fields.
        \\li \\em "CGNS"        -- arrays follow the conventions of the
            NPZ-CGNS helper layout used to round-trip CGNS datasets through
            NPZ.
        \\li \\em "None"        -- no interpretation; every array is exposed
            as a named lazy array on a single dataset prim.
        """
        displayName = "Schema"
        displayGroup = "NPZ File Format"
        customData = {
            string apiName = "schema"
        }
    )

    uniform string omni:cae:format:npz:coordsArray (
        doc = "Optional name of an interleaved Nx3 coordinate array."
        displayName = "Coordinates Array"
        displayGroup = "NPZ File Format"
        customData = {
            string apiName = "coordsArray"
        }
    )

    uniform string omni:cae:format:npz:coordsArrayX (
        doc = "Optional name of the X-coordinate array."
        displayName = "Coordinates X Array"
        displayGroup = "NPZ File Format"
        customData = {
            string apiName = "coordsArrayX"
        }
    )

    uniform string omni:cae:format:npz:coordsArrayY (
        doc = "Optional name of the Y-coordinate array."
        displayName = "Coordinates Y Array"
        displayGroup = "NPZ File Format"
        customData = {
            string apiName = "coordsArrayY"
        }
    )

    uniform string omni:cae:format:npz:coordsArrayZ (
        doc = "Optional name of the Z-coordinate array."
        displayName = "Coordinates Z Array"
        displayGroup = "NPZ File Format"
        customData = {
            string apiName = "coordsArrayZ"
        }
    )

    uniform bool omni:cae:format:npz:allowPickle = false (
        doc = "When true, allow pickle while reading NumPy arrays."
        displayName = "Allow Pickle"
        displayGroup = "NPZ File Format"
        customData = {
            string apiName = "allowPickle"
        }
    )
}

