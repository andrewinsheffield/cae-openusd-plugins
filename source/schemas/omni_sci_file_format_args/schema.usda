class "OmniSciFileFormatArgsPythonAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "PythonAPI"
        token apiSchemaType = "singleApply"
    }
    prepend apiSchemas = ["OmniSciFileFormatArgsAPI"]
    doc = "Python-backed file-format payload arguments."
)
{
    uniform string omni:cae:format:python:module (
        doc = "Python module to import for reading."
        displayName = "Module"
        displayGroup = "Python File Format"
        customData = {
            string apiName = "module"
        }
    )

    uniform string omni:cae:format:python:path (
        doc = "Path prepended to sys.path before importing the reader module."
        displayName = "Path"
        displayGroup = "Python File Format"
        customData = {
            string apiName = "path"
        }
    )

    uniform string omni:cae:format:python:readFunction = "read" (
        doc = "Python read callback function name."
        displayName = "Read Function"
        displayGroup = "Python File Format"
        customData = {
            string apiName = "readFunction"
        }
    )

    uniform string omni:cae:format:python:canReadFunction = "can_read" (
        doc = "Python can-read callback function name."
        displayName = "Can Read Function"
        displayGroup = "Python File Format"
        customData = {
            string apiName = "canReadFunction"
        }
    )

    uniform string omni:cae:format:python:loadArrayFunction = "load_array" (
        doc = "Python lazy-array loading callback function name."
        displayName = "Load Array Function"
        displayGroup = "Python File Format"
        customData = {
            string apiName = "loadArrayFunction"
        }
    )
}
