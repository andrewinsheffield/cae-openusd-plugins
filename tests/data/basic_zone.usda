#usda 1.0
(
    """Basic OmniSciCgns zone fixture -- used by round-trip tests."""
)

def Xform "Zone" (
    prepend apiSchemas = ["OmniSciCgnsZoneAPI"]
)
{
    rel omni:cgns:zone:gridCoordinates = [ </Zone/GridCoordinates> ]
    rel omni:cgns:zone:sections     = [ </Zone/Sec1> ]
    rel omni:cgns:zone:flowSolutions = [ </Zone/FlowSol> ]

    def Xform "GridCoordinates" (
        prepend apiSchemas = ["OmniSciCgnsGridCoordinatesAPI"]
    )
    {
    }

    def Xform "FlowSol" (
        prepend apiSchemas = ["OmniSciCgnsFlowSolutionAPI"]
    )
    {
        uniform token omni:cgns:flow_solution:gridLocation = "CellCenter"
    }

    def Xform "Sec1" (
        prepend apiSchemas = ["OmniSciCgnsUnstructuredElementsAPI"]
    )
    {
        uniform token omni:cgns:unstructured_elements:elementType         = "HEXA_8"
        uniform int   omni:cgns:unstructured_elements:elementSizeBoundary = 0
        uniform int2  omni:cgns:unstructured_elements:elementRange         = (1, 1000)
        rel           omni:cgns:unstructured_elements:zone                 = </Zone>
    }
}
